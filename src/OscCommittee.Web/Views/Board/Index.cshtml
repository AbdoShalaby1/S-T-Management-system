@model BoardDashboardViewModel
@{
    var tiles = new[]
    {
        ("Pending approvals", Model.PendingCount.ToString(), "fa-solid fa-user-clock", "Need a decision"),
        ("Active members", Model.ActiveMemberCount.ToString(), "fa-solid fa-users", "Approved accounts")
    };
}
<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="card-meta">@Model.MonthLabel</p>
            <h1 class="mt-1 text-[26px] font-semibold leading-tight tracking-tight">Board</h1>
            <p class="mt-1 text-sm text-muted">Approve new members, manage accounts, and keep the committee running.</p>
        </div>
        <span class="chip chip-strong">
            <i class="fa-solid fa-shield-halved text-[11px]" aria-hidden="true"></i>
            Board access
        </span>
    </div>

    <section class="grid gap-4 sm:grid-cols-2">
        @foreach (var (label, value, icon, hint) in tiles)
        {
            <article class="stat-tile">
                <div class="flex items-start justify-between gap-2">
                    <p class="stat-label">@label</p>
                    <i class="@icon text-xs text-muted" aria-hidden="true"></i>
                </div>
                <p class="stat-value">@value</p>
                <p class="mt-1 text-xs text-muted">@hint</p>
            </article>
        }
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.6fr_1fr]">
        <article class="card">
            <div class="card-header">
                <h2 class="card-title">Waiting for approval</h2>
                <a asp-controller="Approvals" asp-action="Index" class="text-xs font-medium text-accent hover:text-accent-hover">
                    Open queue
                </a>
            </div>

            @if (Model.PendingCount == 0)
            {
                <div class="card-body">
                    <partial name="_EmptyState" model="@(new EmptyStateModel {
                        Icon = "fa-solid fa-user-check",
                        Title = "Nothing waiting",
                        Description = "New registrations show up here as soon as somebody asks for access."
                    })" />
                </div>
            }
            else
            {
                <ul class="divide-y divide-border/60">
                    @foreach (var item in Model.RecentPending)
                    {
                        <li class="flex flex-wrap items-center gap-3 px-5 py-3.5">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-[11px] font-semibold uppercase text-accent"
                                  aria-hidden="true">@item.Initials</span>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium text-text">@item.DisplayName</p>
                                <p class="truncate text-xs text-muted">@item.Email · requested @item.RequestedOnLabel</p>
                            </div>
                            <form method="post" asp-controller="Approvals" asp-action="Approve" asp-route-id="@item.Id">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-check text-[11px]" aria-hidden="true"></i>
                                    Approve
                                </button>
                            </form>
                        </li>
                    }
                </ul>

                @if (Model.PendingCount > Model.RecentPending.Count)
                {
                    <div class="border-t border-border px-5 py-3 text-xs text-muted">
                        Showing @Model.RecentPending.Count of @Model.PendingCount.
                        <a asp-controller="Approvals" asp-action="Index" class="font-medium text-accent hover:text-accent-hover">See all</a>
                    </div>
                }
            }
        </article>

        <div class="flex flex-col gap-4">
            <article class="card">
                <div class="card-header">
                    <h2 class="card-title">Quick actions</h2>
                </div>
                <div class="card-body flex flex-col gap-2">
                    <a asp-controller="Members" asp-action="Index" class="btn justify-start">
                        <i class="fa-solid fa-users w-4 text-center text-xs text-muted" aria-hidden="true"></i>
                        Member table
                    </a>
                    <a asp-controller="DsSheets" asp-action="Index" class="btn justify-start">
                        <i class="fa-solid fa-layer-group w-4 text-center text-xs text-muted" aria-hidden="true"></i>
                        DS sheets
                    </a>
                    <a asp-controller="Standings" asp-action="Index" class="btn justify-start">
                        <i class="fa-solid fa-ranking-star w-4 text-center text-xs text-muted" aria-hidden="true"></i>
                        Standings
                    </a>
                </div>
            </article>

        </div>
    </section>
</div>
