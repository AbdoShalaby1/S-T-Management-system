@model ContentIndexViewModel
@{
    ViewData["Title"] = "Topics";
    var count = Model.Pages.Count;
}
<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="card-meta">Community</p>
            <h1 class="mt-1 text-[26px] font-semibold leading-tight tracking-tight">Topics</h1>
        </div>
        @if (count > 0)
        {
            <span class="chip">
                <i class="fa-solid fa-book-open text-[11px] text-muted" aria-hidden="true"></i>
                <span class="nums">@count</span> @(count == 1 ? "topic" : "topics")
            </span>
        }
    </div>

    @if (count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel {
            Icon = "fa-solid fa-book-open",
            Title = "No topics yet",
            Description = "Published guides and references will appear here."
        })" />
    }
    else
    {
        <section class="grid gap-4 sm:grid-cols-2" aria-label="Published topics">
            @foreach (var entry in Model.Pages)
            {
                <a href="@entry.Href"
                   class="card group flex flex-col gap-3 p-5 transition-colors hover:border-accent/40 hover:bg-elevated">
                    <div class="flex items-start justify-between gap-3">
                        <h2 class="text-[17px] font-semibold tracking-tight text-text">@entry.Title</h2>
                        <i class="fa-solid fa-arrow-right mt-1 text-xs text-muted transition-colors group-hover:text-accent"
                           aria-hidden="true"></i>
                    </div>

                    <p class="mt-auto flex items-center gap-1.5 border-t border-border/60 pt-3 text-[11px] text-muted">
                        <i class="fa-regular fa-clock text-[10px]" aria-hidden="true"></i>
                        Updated <span class="nums text-text">@entry.UpdatedLabel</span>
                    </p>
                </a>
            }
        </section>
    }
</div>