@model DsOverviewViewModel
@{
    var active = Model.ActiveSheet;
}
<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="card-meta">@Model.MonthLabel</p>
            <h1 class="mt-1 text-[26px] font-semibold leading-tight tracking-tight">Data structures</h1>
        </div>
        @if (Model.SheetCount > 0)
        {
            <span class="chip">
                <i class="fa-solid fa-layer-group text-[11px] text-muted" aria-hidden="true"></i>
                <span class="nums">@Model.SheetCount</span>
                @(Model.SheetCount == 1 ? "sheet" : "sheets")
            </span>
        }
    </div>

    @if (Model.Groups.Count > 0)
    {
        <section aria-label="Current sheet">
            @if (active is null)
            {
                <partial name="_EmptyState" model="@(new EmptyStateModel {
                    Icon = "fa-solid fa-bolt",
                    Title = "No current sheet",
                    Description = "Visible sheets are still listed below."
                })" />
            }
            else
            {
                <article class="card border-accent/30 bg-accent-soft/20">
                    <div class="card-body">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div class="min-w-0">
                                <span class="chip chip-strong">
                                    <i class="fa-solid fa-bolt text-[11px]" aria-hidden="true"></i>
                                    Current
                                </span>
                                <h2 class="mt-3 text-xl font-semibold tracking-tight text-text">@active.Title</h2>
                                <p class="mt-1 text-sm text-muted">@active.MonthLabel</p>
                                <p class="mt-3 text-sm text-muted">
                                    <i class="fa-regular fa-clock mr-1.5 text-xs" aria-hidden="true"></i>
                                    Deadline <span class="nums font-medium text-text">@active.DueLabel</span>
                                </p>
                                <p class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted">
                                    <span data-countdown-to="@active.DueIso">@(active.IsOverdue ? "overdue" : "soon")</span>
                                </p>
                            </div>
                            <a asp-controller="Ds" asp-action="Sheet" asp-route-id="@active.Id" class="btn btn-primary shrink-0">
                                Open sheet
                                <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </section>
    }

    <section class="flex flex-col gap-3" aria-label="All sheets">
        <div class="flex items-center justify-between gap-3">
            <h2 class="section-title">All sheets</h2>
        </div>

        @if (Model.Groups.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel {
                Icon = "fa-solid fa-layer-group",
                Title = "No sheets yet",
                Description = "Published problem sets will appear here."
            })" />
        }
        else
        {
            @foreach (var group in Model.Groups)
            {
                <details class="accordion card overflow-hidden" open="@(group.IsCurrent ? "open" : null)">
                    <summary class="card-header gap-3">
                        <span class="flex min-w-0 items-center gap-2.5">
                            <i class="accordion-chevron fa-solid fa-chevron-right text-[10px] text-muted" aria-hidden="true"></i>
                            <span class="card-title">@group.Label</span>
                            @if (group.IsCurrent)
                            {
                                <span class="badge badge-active">Current</span>
                            }
                        </span>
                        <span class="chip shrink-0">
                            <span class="nums">@group.Sheets.Count</span>
                            @(group.Sheets.Count == 1 ? "sheet" : "sheets")
                        </span>
                    </summary>

                    <div class="grid gap-3 p-4 sm:grid-cols-2">
                        @foreach (var sheet in group.Sheets)
                        {
                            <a asp-controller="Ds" asp-action="Sheet" asp-route-id="@sheet.Id"
                               class="rounded-card border border-border bg-surface p-4 transition-colors hover:border-accent/40 hover:bg-surface-2">
                                <div class="flex items-start justify-between gap-2">
                                    <h3 class="text-sm font-semibold text-text">@sheet.Title</h3>
                                    @if (sheet.IsActive)
                                    {
                                        <span class="badge badge-active shrink-0">Current</span>
                                    }
                                    else if (sheet.IsOverdue)
                                    {
                                        <span class="badge badge-late shrink-0">Closed</span>
                                    }
                                </div>

                                <p class="mt-2.5 flex items-center gap-1.5 text-xs text-muted">
                                    <i class="fa-regular fa-clock text-[11px]" aria-hidden="true"></i>
                                    Deadline
                                    <span class="nums text-text" data-countdown-to="@sheet.DueIso">@(sheet.IsOverdue ? "overdue" : "soon")</span>
                                </p>
                                <p class="mt-1 text-[11px] text-muted/70 nums">@sheet.DueLabel</p>

                                <div class="mt-3 flex items-center justify-between gap-2 border-t border-border/60 pt-3">
                                    <span class="text-[11px] text-muted">
                                        <span class="nums">@sheet.ProblemCount</span>
                                        @(sheet.ProblemCount == 1 ? "problem" : "problems")
                                    </span>
                                    <span class="text-[11px] font-medium text-accent">Open sheet →</span>
                                </div>
                            </a>
                        }
                    </div>
                </details>
            }
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/countdown.js" asp-append-version="true"></script>
}