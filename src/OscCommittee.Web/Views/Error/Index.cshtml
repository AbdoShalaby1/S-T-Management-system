@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="mx-auto flex max-w-lg flex-col items-center py-16 text-center">
    <p class="font-mono text-sm font-medium text-accent nums">@Model.StatusCode</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight">@Model.Title</h1>
    <p class="mt-2 text-sm leading-relaxed text-muted">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-xs text-muted/70">
            Request id <code class="kbd">@Model.RequestId</code>
        </p>
    }

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
            <i class="fa-solid fa-house text-xs" aria-hidden="true"></i>
            Back to dashboard
        </a>
        <button type="button" class="btn btn-ghost" data-back>
            <i class="fa-solid fa-arrow-left text-xs" aria-hidden="true"></i>
            Go back
        </button>
    </div>
</div>
