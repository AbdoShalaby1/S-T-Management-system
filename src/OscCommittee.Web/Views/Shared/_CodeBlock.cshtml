@model CodeBlockModel
@{
    var language = string.IsNullOrWhiteSpace(Model.Language) ? "csharp" : Model.Language;
    var label = string.IsNullOrWhiteSpace(Model.FileName) ? language.ToUpperInvariant() : Model.FileName;
}
<div class="code-shell">
    <div class="code-shell-head">
        <span class="code-shell-name">
            <i class="fa-solid fa-file-code mr-1.5 text-[10px] text-muted" aria-hidden="true"></i>
            @label
        </span>
        <button type="button" class="btn btn-sm" data-copy data-copy-target="#@Model.ElementId"
                title="Copy this block">
            <i class="fa-regular fa-copy text-[10px]" aria-hidden="true"></i>
            Copy
        </button>
    </div>
    <pre class="line-numbers"><code id="@Model.ElementId" class="language-@language">@Model.Code</code></pre>
</div>