@model EmptyStateModel
<div class="empty-state">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent/90 ring-1 ring-inset ring-accent/20">
        <i class="@Model.Icon text-sm" aria-hidden="true"></i>
    </span>
    <p class="mt-3 text-sm font-medium text-text">@Model.Title</p>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted">@Model.Description</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionLabel) && !string.IsNullOrWhiteSpace(Model.ActionHref))
    {
        <a href="@Model.ActionHref" class="btn btn-ghost mt-4">@Model.ActionLabel</a>
    }
</div>
