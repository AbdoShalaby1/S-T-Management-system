@using OscCommittee.Web.Services.Accounts
@{
    var displayName = User.FindFirst(AppUserClaimsPrincipalFactory.DisplayNameClaim)?.Value
        ?? User.Identity?.Name
        ?? "Member";
    var words = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = words.Length == 0 ? "?" : string.Concat(words.Take(2).Select(word => char.ToUpperInvariant(word[0])));
}
<header class="sticky top-0 z-30 border-b border-border bg-bg">
    <div class="mx-auto flex h-16 w-full max-w-[1200px] items-center gap-2 px-4 sm:px-6 lg:px-8">
        <button id="nav-toggle" type="button" class="btn-icon lg:hidden"
                aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <a href="@(User.IsInRole(Roles.Board) ? Url.Action("Index", "Board") : Url.Action("Index", "Home"))"
           class="flex items-center gap-2 lg:hidden">
            <img src="~/img/osc.png" asp-append-version="true" alt=""
                 class="h-7 w-7 shrink-0 rounded-md object-contain" />
            <span class="text-sm font-semibold tracking-tight">OSC S&amp;T</span>
        </a>

        <div class="ml-auto flex items-center gap-1.5">
            @if (User.IsInRole(Roles.Board))
            {
                <span class="flex items-center gap-2 rounded-full border border-border bg-surface py-1 pl-1 pr-2.5">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-[11px] font-semibold uppercase text-accent"
                          aria-hidden="true">@initials</span>
                    <span class="hidden max-w-[12rem] truncate text-sm font-medium sm:block">@displayName</span>
                </span>
            }
            else
            {
                <div class="relative">
                    <button id="user-menu-button" type="button"
                            class="flex items-center gap-2 rounded-full border border-border bg-surface py-1 pl-1 pr-2.5 transition-colors hover:bg-surface-2"
                            aria-expanded="false" aria-controls="user-menu">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-soft text-[11px] font-semibold uppercase text-accent"
                              aria-hidden="true">@initials</span>
                        <span class="hidden max-w-[12rem] truncate text-sm font-medium sm:block">@displayName</span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-muted" aria-hidden="true"></i>
                    </button>

                    <div id="user-menu"
                         class="absolute right-0 mt-2 hidden w-52 rounded-input border border-border bg-elevated p-1 shadow-pop">
                        <a asp-controller="Settings" asp-action="Index"
                           class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-text">
                            <i class="fa-solid fa-gear w-4 text-center text-xs" aria-hidden="true"></i>
                            Settings
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</header>
