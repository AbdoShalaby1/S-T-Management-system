@model SubmissionPageViewModel
@if (!string.IsNullOrWhiteSpace(Model.Summary))
{
    <div class="rounded-input border border-border bg-surface-2/40 px-3 py-2.5">
        <p class="stat-label">Summary</p>
        <p class="mt-1 text-sm leading-relaxed text-muted">@Model.Summary</p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Verdict))
{
    <p class="text-sm text-text">
        <span class="stat-label mr-2">Verdict</span>@Model.Verdict
    </p>
}

@if (Model.Strengths.Count > 0)
{
    <div>
        <p class="stat-label">What worked</p>
        <ul class="mt-1.5 flex flex-col gap-1.5">
            @foreach (var strength in Model.Strengths)
            {
                <li class="flex gap-2 text-sm leading-relaxed text-muted">
                    <i class="fa-solid fa-check mt-1 text-[10px] text-success" aria-hidden="true"></i>
                    <span>@strength</span>
                </li>
            }
        </ul>
    </div>
}

@if (Model.Issues.Count > 0)
{
    <div class="flex flex-col gap-3">
        <p class="stat-label">Issues</p>
        @foreach (var group in new[]
        {
            (Title: "Must fix", Items: Model.MustFix),
            (Title: "Should fix", Items: Model.ShouldFix),
            (Title: "Nits", Items: Model.Nits)
        })
        {
            @if (group.Items.Count > 0)
            {
                <div>
                    <p class="text-[11px] font-medium uppercase tracking-wide text-muted">@group.Title</p>
                    <ul class="mt-1.5 flex flex-col gap-1.5">
                        @foreach (var issue in group.Items)
                        {
                            <li class="rounded-input border border-border bg-surface-2/40 px-3 py-2">
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="badge @issue.SeverityBadgeClass">@issue.SeverityLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(issue.File))
                                    {
                                        <span class="font-mono text-[11px] text-muted">@issue.File</span>
                                    }
                                </div>
                                <p class="mt-1 text-sm leading-relaxed text-text">@issue.Message</p>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
}