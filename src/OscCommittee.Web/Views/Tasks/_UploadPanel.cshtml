@model TaskPageViewModel

<form method="post"
      asp-controller="Tasks"
      asp-action="Submit"
      asp-route-id="@Model.Id"
      enctype="multipart/form-data"
      data-upload
      data-max-files="@Model.MaxFiles"
      data-max-total-mb="@Model.MaxTotalMb"
      data-max-file-mb="@Model.MaxFileMb"
      class="flex flex-col gap-3">
    <div class="upload-zone" data-upload-zone>
        <i class="fa-solid fa-folder-open text-xl text-muted" aria-hidden="true"></i>
        <p class="mt-2 text-sm font-medium text-text">Drop your project folder here</p>
        <p class="mt-1 text-xs leading-relaxed text-muted">or choose it from your computer.</p>

        <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
            <label for="folder-input" class="btn btn-sm btn-primary cursor-pointer">
                <i class="fa-solid fa-folder-tree text-[11px]" aria-hidden="true"></i>
                Select folder
            </label>
            <button type="button" class="btn btn-sm" data-upload-clear hidden>Clear</button>
        </div>

        <input id="folder-input"
               type="file"
               name="files"
               webkitdirectory
               directory
               multiple
               data-upload-folder
               class="sr-only" />
    </div>

    <div class="flex flex-col gap-2" data-upload-selection hidden>
        <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-xs font-medium text-text" data-upload-summary aria-live="polite">0 files</p>
            <p class="text-[11px] text-muted" data-upload-size>0.0 KB</p>
        </div>

        <ul class="max-h-32 overflow-y-auto rounded-input border border-border bg-surface-2/40 p-2 font-mono text-[10px] text-muted"
            data-upload-list></ul>

        <p class="hidden rounded-input border border-danger/30 bg-danger/10 px-3 py-2 text-[11px] leading-relaxed text-danger"
           data-upload-error></p>

        <p class="hidden rounded-input border border-warning/30 bg-warning/10 px-3 py-2 text-[11px] leading-relaxed text-warning"
           data-upload-warning></p>
    </div>

    <div class="flex flex-col gap-1.5" data-upload-progress hidden>
        <div class="upload-track" role="progressbar" aria-label="Upload progress"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-upload-track>
            <div class="upload-bar" data-upload-bar></div>
        </div>
        <p class="text-[11px] text-muted" data-upload-percent aria-live="polite">0%</p>
    </div>

    <button type="submit" class="btn btn-primary w-full" data-upload-submit disabled>
        <i class="fa-solid fa-cloud-arrow-up text-xs" aria-hidden="true"></i>
        Upload
    </button>

    <p class="text-center text-[11px] leading-relaxed text-muted/70">
        Up to <span class="nums">@Model.MaxFiles</span> files,
        <span class="nums">@Model.MaxTotalMb</span> MB total,
        <span class="nums">@Model.MaxFileMb</span> MB each. At least one
        <span class="font-mono">.cs</span> file.
    </p>

    @if (Model.IsOverdue)
    {
        <p class="rounded-input border border-warning/30 bg-warning/10 px-3 py-2 text-[11px] leading-relaxed text-warning">
            Late upload: still graded, worth 0 points.
        </p>
    }
</form>